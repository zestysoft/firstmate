doc command (configuration.md): printf '\nsound:off\n' >> "${FM_CONFIG_OVERRIDE:-${FM_HOME:-.}/config}/usage-warner"
doc command (wedge-alarm.md):   printf '\nsound:off\n' >> "${FM_CONFIG_OVERRIDE:-${FM_HOME:-.}/config}/wedge-alarm"
usage-warner: five_hour at 85% (>=80%)
--- usage-warner [uw-doc-override] override=1
  custom-config/usage-warner:
    | five_hour:80
    | 
    | sound:off
  osascript argv:
    <-e>
    <on run argv>
    <-e>
    <display notification (item 1 of argv) with title "Firstmate: Claude usage" sound name "">
    <-e>
    <end run>
    <five_hour at 85% (>=80%)>
  RESULT: silent (sound name "")
