--- wedge-alarm [wa-doc-override] override=1
  custom-config/wedge-alarm:
    | 
    | sound:off
  osascript argv:
    <-e>
    <on run argv>
    <-e>
    <display notification (item 1 of argv) with title "firstmate: away-mode escalations WEDGED" sound name (item 2 of argv)>
    <-e>
    <end run>
    <away-mode WEDGED 900s>
    <>
  RESULT: silent (empty sound name)
